0:["X8h45cP1blEmncjlnJCV4",[[["",{"children":["about",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["about",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"style":{"maxWidth":820,"margin":"0 auto","padding":"52px 24px 80px","fontFamily":"ui-rounded, system-ui, sans-serif","color":"#2B1B12"},"children":[["$","p",null,{"style":{"fontSize":11,"fontWeight":600,"textTransform":"uppercase","letterSpacing":"0.2em","color":"#2FB7B5","margin":"0 0 12px"},"children":"🐾 Our Story"}],["$","h1",null,{"style":{"fontSize":"clamp(28px, 4vw, 48px)","fontWeight":900,"margin":"0 0 40px","letterSpacing":"-0.03em","lineHeight":1.1},"children":"Beyond Basics."}],["$","div",null,{"style":{"fontSize":"1.05rem","lineHeight":1.9,"color":"#4a3428"},"children":[["$","p",null,{"children":"Petscream didn't start as a business idea. It started from everyday life with animals and from paying attention to the small moments that often go unnoticed."}],["$","p",null,{"children":"Over time, we noticed something. Treats had become routine, often filled with ingredients that didn't feel right or easy to trust."}],["$","p",null,{"children":"So we slowed down and started asking a simple question. What if treats could feel more intentional?"}],["$","p",null,{"children":"We believe a treat should do more than taste good. It should feel good too."}],["$","p",null,{"children":"That's why we focused on clean ingredients and gentle digestion, building everything around a goat milk-based blend that's easier on the stomach and made for everyday moments."}],["$","p",null,{"style":{"fontStyle":"italic","color":"#2B1B12","fontWeight":600},"children":"Made to feel like ice cream. Built to be better."}],["$","p",null,{"children":"No unnecessary extras. No exaggerated claims. Just something you can give with quiet confidence."}],["$","p",null,{"children":"Petscream grew out of this belief. Not to be louder, but to be better."}],["$","p",null,{"children":"And in the end, it's about something simple. A small moment, a shared pause, and a treat that actually feels right."}],["$","p",null,{"style":{"marginTop":32,"fontSize":"1.1rem","color":"#2B1B12","lineHeight":1.8},"children":"And honestly, the best part?"}],["$","p",null,{"style":{"fontSize":"1.1rem","color":"#2B1B12","lineHeight":1.8},"children":"That moment when your dog takes the first lick, pauses for a second like they just discovered something new, and then comes right back for more."}],["$","p",null,{"style":{"fontWeight":900,"fontSize":"1.2rem","marginTop":8,"color":"#2B1B12"},"children":"That's Petscream."}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","about","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/615cf57ce6a9c977.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L4",null,{"children":[["$","$L5",null,{}],["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@medi